{
  "entities": {
    "ContactInquiry": {
      "title": "Contact Inquiry",
      "description": "Inquiries submitted via portfolio contact form",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Sender name",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Sender email address",
          "maxLength": 150
        },
        "subject": {
          "type": "string",
          "description": "Inquiry subject",
          "maxLength": 200
        },
        "message": {
          "type": "string",
          "description": "Inquiry message content",
          "maxLength": 5000
        },
        "status": {
          "type": "string",
          "enum": ["new", "read", "archived"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["name", "email", "message"]
    },
    "NewsletterSubscriber": {
      "title": "Newsletter Subscriber",
      "description": "Email newsletter subscriptions",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 150
        },
        "source": {
          "type": "string",
          "maxLength": 100
        },
        "subscribedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email"]
    },
    "ViewCount": {
      "title": "View Count",
      "description": "Dynamic view count and popularity telemetry for projects and articles",
      "type": "object",
      "properties": {
        "itemId": {
          "type": "string",
          "description": "Identifier or slug of the project or article",
          "maxLength": 128
        },
        "itemType": {
          "type": "string",
          "description": "Category of the item being viewed",
          "enum": ["project", "article"]
        },
        "views": {
          "type": "number",
          "description": "Cumulative total view count"
        },
        "lastViewedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of the most recent view"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of the last telemetry update"
        }
      },
      "required": ["itemId", "itemType", "views"]
    }
  },
  "firestore": {
    "/contact_inquiries/{inquiryId}": {
      "schema": "ContactInquiry",
      "description": "User submitted contact inquiries"
    },
    "/newsletter_subscribers/{subscriberId}": {
      "schema": "NewsletterSubscriber",
      "description": "Email newsletter subscriptions"
    },
    "/view_counts/{viewId}": {
      "schema": "ViewCount",
      "description": "Dynamic view counts and popularity metrics for projects and articles"
    }
  }
}
