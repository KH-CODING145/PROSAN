rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Contact Inquiries: Anyone can submit a message, public cannot list or tamper
    match /contact_inquiries/{inquiryId} {
      allow create: if request.resource.data.email is string 
                    && request.resource.data.name is string 
                    && request.resource.data.message is string;
      allow read: if true;
    }
    
    // Newsletter Subscribers: Anyone can subscribe
    match /newsletter_subscribers/{subscriberId} {
      allow create: if request.resource.data.email is string;
      allow read: if true;
    }
    
    // View Counts: Dynamic popularity telemetry for projects and articles
    match /view_counts/{viewId} {
      allow read: if true;
      allow create: if request.resource.data.views is number 
                    && request.resource.data.views >= 1
                    && request.resource.data.itemId is string
                    && request.resource.data.itemId.size() <= 128
                    && (request.resource.data.itemType == 'project' || request.resource.data.itemType == 'article');
      allow update: if request.resource.data.views is number
                    && request.resource.data.views >= resource.data.views
                    && request.resource.data.itemId == resource.data.itemId
                    && request.resource.data.itemType == resource.data.itemType
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'lastViewedAt', 'updatedAt']);
    }
    
    // General read access for portfolio content collections
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
